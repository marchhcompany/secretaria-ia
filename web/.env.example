# Banco PostgreSQL (Neon, Supabase ou outro)
DATABASE_URL=
# Login
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# IA (Anthropic). O modelo pode ser trocado por empresa no painel.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# WhatsApp (Cloud API oficial da Meta) — ver docs/whatsapp-meta.md
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Token global (número da própria March / testes). Clientes podem ter token próprio, salvo cifrado no banco.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Espera (ms) antes de responder, para juntar mensagens seguidas.
WHATSAPP_DEBOUNCE_MS=4000

# Cifra de segredos guardados no banco (texto aleatório, 32+ caracteres). Não trocar depois de salvar tokens.
DATA_ENCRYPTION_KEY=
# Protege /api/cron/automations (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# E-mails (recuperação de senha e alertas de atendimento humano)
RESEND_API_KEY=
EMAIL_FROM=

# Só para exibição de custos em reais
USD_BRL=5.4
